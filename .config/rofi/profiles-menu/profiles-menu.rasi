/*****----- Configuration -----*****/
configuration {
    show-icons:                 false;
}

/*****----- Global Properties -----*****/
@import                         "shared/colors.rasi"
@import                         "shared/fonts.rasi"
@import                         "shared/main_theme.rasi"

/*****----- Main Window -----*****/
window {
    transparency:               "real";
    location:                   west;
    anchor:                     west;
    fullscreen:                 false;
    width:                      250px;
    x-offset:                   10px;
    y-offset:                   0px;
    enabled:                    true;
    margin:                     0px;
    padding:                    0px;
    border:                     0px solid;
    border-radius:              18px;
    border-color:               @selected;
    cursor:                     "default";
    background-color:           @background;
}

/*****----- Main Box -----*****/
mainbox {
    enabled:                    true;
    spacing:                    15px;
    margin:                     0px;
    padding:                    15px;
    border:                     0px solid;
    border-radius:              18px;
    border-color:               @selected;
    background-color:           transparent;
    children:                   [ "listview" ];
}

/*****----- Inputbar -----*****/
inputbar {
    enabled:                    true;
    spacing:                    0px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px;
    border-radius:              0px;
    border-color:               @selected;
    background-color:           transparent;
    text-color:                 @foreground;
    children:                   [ "textbox-prompt-colon", "prompt"];
}

dummy {
    background-color:           transparent;
}

textbox-prompt-colon {
    enabled:                    true;
    expand:                     false;
    str:                        "";
    padding:                    12px 16px;
    border-radius:              0px;
    background-color:           @urgent;
    text-color:                 @background;
}
prompt {
    enabled:                    true;
    padding:                    12px;
    border-radius:              0px;
    background-color:           @active;
    text-color:                 @background;
}

/*****----- Message -----*****/
message {
    enabled:                    true;
    margin:                     0px;
    padding:                    12px;
    border:                     0px solid;
    border-radius:              100%;
    border-color:               @selected;
    background-color:           @background-alt;
    text-color:                 @foreground;
}
textbox {
    background-color:           inherit;
    text-color:                 inherit;
    vertical-align:             0.5;
    horizontal-align:           0.5;
    placeholder-color:          @foreground;
    blink:                      true;
    markup:                     true;
}
error-message {
    padding:                    12px;
    border:                     0px solid;
    border-radius:              0px;
    border-color:               @selected;
    background-color:           @background;
    text-color:                 @foreground;
}

/*****----- Listview -----*****/
listview {
    enabled:                    true;
    columns:                    1;
    lines:                      2;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    reverse:                    false;
    fixed-height:               true;
    fixed-columns:              true;
    
    spacing:                    15px;
    margin:                     0px;
    padding:                    0px;
    border:                     0px solid;
    border-radius:              0px;
    border-color:               @selected;
    background-color:           transparent;
    text-color:                 @foreground;
    cursor:                     "default";
}

/*****----- Elements -----*****/
element {
    enabled:                    true;
    spacing:                    10px;
    margin:                     0px;
    padding:                    12px 16px;
    border:                     0px solid;
    border-radius:              18px;
    border-color:               @selected;
    background-color:           @background-alt;
    text-color:                 @foreground;
    cursor:                     pointer;
}
element-text {
    font:                       "feather bold 12";
    background-color:           transparent;
    text-color:                 inherit;
    cursor:                     inherit;
    vertical-align:             0.5;
    horizontal-align:           0.0;
}
