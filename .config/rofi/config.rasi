@import "shared/colors.rasi"
@import "shared/fonts.rasi"
@import "shared/icons.rasi"
@import "shared/main_theme.rasi"

configuration {
    modi:                "drun,window";
    show-icons:          true;
    display-drun:        "";
    display-window:      "";
    drun-display-format: "{name}";
    window-format:       "{w} · {c} · {t}";
}

window {
    location:         center;
    anchor:           center;
    width:            600px;
    border-radius:    10px;
    background-color: @background;
}

mainbox {
    spacing:          0px;
    padding:          10px;
    background-color: transparent;
    children:         [ "inputbar", "listview" ];
}

inputbar {
    expand:           false;
    padding:          0px;
    margin:           0px;
    spacing:          0px;
    background-color: transparent;
    text-color:       transparent;
    children:         [ "entry" ];
}

entry {
    expand:            false;
    width:             1px;
    height:            1px;
    padding:           0px;
    margin:            0px;
    font:              "monospace 1";
    background-color:  transparent;
    text-color:        transparent;
    placeholder:       "";
    placeholder-color: transparent;
}

listview {
    columns:          1;
    lines:            6;
    cycle:            true;
    dynamic:          true;
    fixed-height:     true;
    fixed-columns:    true;
    scrollbar:        true;
    scroll-method:    1;
    spacing:          5px;
    margin:           -4px 0px 0px 0px;
    background-color: transparent;
    text-color:       @foreground-color;
}

scrollbar {
    handle-width:     6px;
    handle-color:     rgba(127, 184, 184, 0.55);
    background-color: rgba(255, 255, 255, 0.04);
    border-radius:    100%;
    margin:           4px 4px 4px 8px;
}

element {
    spacing:          10px;
    padding:          5px 10px;
    border-radius:    10px;
    background-color: transparent;
    text-color:       @foreground-color;
    cursor:           pointer;
}

element normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}

element-icon {
    size:             24px;
    background-color: transparent;
    text-color:       inherit;
}

element-text {
    highlight:        bold;
    vertical-align:   0.5;
    background-color: transparent;
    text-color:       inherit;
}
